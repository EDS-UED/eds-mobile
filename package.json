{
  "name": "eds-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "EDS Mobile — React Native component library with Figma-synced tokens",
  "scripts": {
    "dev": "node scripts/dev-showcase.mjs",
    "dev:showcase": "node scripts/dev-showcase.mjs",
    "dev:showcase:expo-only": "pnpm --filter @eds/mobile-showcase dev",
    "watch:tokens": "node scripts/watch-tokens.mjs",
    "watch:linked-consumers": "node scripts/watch-linked-consumers.mjs",
    "build": "pnpm build:mobile",
    "build:tokens": "pnpm --filter @eds/mobile-tokens build",
    "build:animations": "pnpm --filter @eds/mobile-animations build",
    "build:components": "pnpm --filter @eds/mobile-components build",
    "build:patterns": "pnpm --filter @eds/mobile-patterns build",
    "build:workflows": "pnpm --filter @eds/mobile-workflows build",
    "build:mobile": "pnpm build:tokens && pnpm build:animations && pnpm build:components && pnpm build:patterns && pnpm build:workflows && pnpm --filter @eds-evergreen/mobile build",
    "publish:mobile": "pnpm build:mobile && pnpm --filter @eds-evergreen/mobile publish --access public",
    "parity:native": "node scripts/parity/collect-native.mjs",
    "sync": "node scripts/sync-local-consumers.mjs",
    "sync:list": "node scripts/sync-local-consumers.mjs --list",
    "sync:tokens": "pnpm --filter @eds/mobile-tokens sync:figma",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4"
}
