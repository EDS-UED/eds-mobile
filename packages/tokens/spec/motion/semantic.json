{
  "$figma": "https://www.figma.com/design/LlB2jT8KdxM6taf5wOSAEM/EverGreen-Design-System--Mobile-",
  "$description": "EDS Mobile Motion Semantic — 封装好的场景 class（沿用现有命名，非文档 8 场景）。只引用 Recipe，不存底层参数。",
  "groups": [
    {
      "comment": "1 · Tap（点按 · event-tap*）",
      "styles": [
        {
          "title": "点按反馈 · Button / List Item / Icon",
          "className": "motion-tap",
          "recipe": "press",
          "properties": {
            "transition": "var(--motion-recipe-tap)"
          },
          "stateStyles": [
            {
              "hostClass": "motion-tap.is-active",
              "title": "按下态",
              "properties": {
                "transform": "scale(var(--motion-scale-press))"
              }
            }
          ],
          "notes": ["Semantic → Recipe(press) → Base(spring.press · haptic.light)"]
        }
      ]
    },
    {
      "comment": "1.5 · Focus（Input / Search 边框 · 无 hover）",
      "styles": [
        {
          "title": "聚焦态 · Input / Search",
          "className": "motion-focus",
          "recipe": "enter",
          "properties": {
            "transition": "var(--motion-recipe-enter)"
          },
          "notes": ["Semantic → Recipe(enter) → Base(timing.easeIn)"]
        }
      ]
    },
    {
      "comment": "2 · Layout（大位移 · Drawer / Panel）",
      "styles": [
        {
          "title": "大位移进出场",
          "className": "motion-layout",
          "recipe": "enter",
          "activeModifier": "is-active",
          "properties": {
            "transition": "var(--motion-recipe-enter)",
            "opacity": "var(--motion-opacity-hidden)",
            "transform": "translateY(var(--motion-distance-sm))"
          },
          "activeState": {
            "opacity": "var(--motion-opacity-visible)",
            "transform": "translateY(0)"
          },
          "parentActiveSelectors": [".is-active"],
          "selfActiveSelectors": []
        }
      ]
    },
    {
      "comment": "3 · Flotation（Sheet / Modal / Toast / Popover）",
      "styles": [
        {
          "title": "浮层进出场",
          "className": "motion-flotation",
          "recipe": "sheet",
          "activeModifier": "is-active",
          "properties": {
            "transition": "var(--motion-recipe-flotation-enter)",
            "opacity": "var(--motion-opacity-hidden)",
            "transform": "translateY(var(--motion-offset-flotation-y)) scale(var(--motion-scale-present))"
          },
          "activeState": {
            "opacity": "var(--motion-opacity-visible)",
            "transform": "translateY(0) scale(1)"
          },
          "parentActiveSelectors": [".is-active"],
          "selfActiveSelectors": []
        }
      ]
    },
    {
      "comment": "4 · Deform（Tab 指示器 / Toggle / Segmented）",
      "styles": [
        {
          "title": "控件形变",
          "className": "motion-deform",
          "recipe": "control",
          "properties": {
            "transition": "var(--motion-recipe-control)"
          },
          "notes": ["Semantic → Recipe(control) → Base(spring.control)"]
        }
      ]
    },
    {
      "comment": "5 · Page（Stack Push / Pop）",
      "styles": [
        {
          "title": "页面转场",
          "className": "motion-page",
          "recipe": "navigation",
          "properties": {
            "transition": "var(--motion-recipe-page-push)"
          },
          "notes": ["Semantic → Recipe(navigation) → Base(spring.navigation · timing.navigationPush)"]
        }
      ]
    },
    {
      "comment": "6 · Layout Deform（容器 morph）",
      "styles": [
        {
          "title": "容器尺寸 morph",
          "className": "motion-layout-deform",
          "recipe": "layout-deform",
          "properties": {
            "overflow": "hidden",
            "transition": "var(--motion-recipe-layout-deform-shell)"
          }
        }
      ]
    }
  ],
  "utilityClasses": [
    {
      "title": "无过渡",
      "className": "motion-none",
      "standaloneTransition": "none",
      "notes": ["Reduce Motion 降级 · Semantic → instant"]
    },
    {
      "title": "Reduce Motion 降级 · 仅 fade",
      "className": "motion-reduced-fade",
      "standaloneTransition": "opacity var(--motion-duration-fade) var(--motion-easing-standard)",
      "notes": ["Slide/Translate → Fade · motion.accessibility.reducedMotion"]
    }
  ],
  "reducedMotionScenarioClasses": [
    "motion-tap",
    "motion-tap.is-active",
    "motion-focus",
    "motion-layout",
    "motion-flotation",
    "motion-deform",
    "motion-page",
    "motion-layout-deform"
  ],
  "reducedMotion": {
    "mediaQuery": "prefers-reduced-motion: reduce",
    "durationToken": "var(--eds-motion-0)",
    "simplifications": [
      { "from": "motion-layout", "toStrategy": "fade", "utilityClass": "motion-reduced-fade" },
      { "from": "motion-flotation", "toStrategy": "fade", "utilityClass": "motion-reduced-fade" },
      { "from": "motion-page", "toStrategy": "fade", "utilityClass": "motion-reduced-fade" },
      { "from": "motion-layout-deform", "toStrategy": "fade", "utilityClass": "motion-reduced-fade" },
      { "from": "motion-tap", "toStrategy": "instant", "utilityClass": "motion-none" }
    ],
    "rules": [
      "Slide → Fade",
      "Shared Element → Cross Fade",
      "Large Title collapse → Opacity only",
      "禁止 animation: none 一刀切；使用 motion-reduced-fade / motion-none"
    ],
    "hapticReduced": {
      "enabled": false,
      "notes": ["Reduce Motion 开启时可选择弱化 haptic；由 consumer AccessibilityInfo 决定"]
    }
  },
  "compositions": [
    {
      "id": "ios-navigation",
      "label": "iOS Navigation",
      "semanticClass": "motion-page",
      "push": { "recipe": "navigation" },
      "pop": { "recipe": "navigation" },
      "interactivePop": { "recipe": "interactive" }
    },
    {
      "id": "ios-sheet",
      "label": "iOS Sheet",
      "semanticClass": "motion-flotation",
      "presentation": { "recipe": "sheet" },
      "interaction": { "recipe": "interactive" },
      "dismiss": { "recipe": "dismiss" },
      "snapPoints": [0.25, 0.5, 0.75, 1],
      "haptic": { "snap": "selection" }
    },
    {
      "id": "ios-modal",
      "label": "iOS Modal",
      "semanticClass": "motion-flotation",
      "presentation": { "recipe": "modal" },
      "content": { "recipe": "modal", "scaleFrom": "motion-scale-present", "opacityFrom": "motion-opacity-hidden" },
      "backdrop": { "opacity": "motion-opacity-dim" },
      "dismiss": { "recipe": "exit", "springRef": "default" }
    },
    {
      "id": "ios-popover",
      "label": "iOS Popover",
      "semanticClass": "motion-flotation",
      "presentation": { "recipe": "modal" },
      "scale": { "from": "motion-scale-present", "to": "1" },
      "opacity": { "from": "motion-opacity-hidden", "to": "motion-opacity-visible" }
    },
    {
      "id": "ios-large-title",
      "label": "iOS Large Title",
      "type": "scroll-linked",
      "scrollRange": { "start": 0, "end": 44 },
      "scale": { "from": 1, "to": 0.82 },
      "opacity": { "from": 1, "to": 0 },
      "navigationBar": { "opacityFrom": 0, "opacityTo": 1 }
    },
    {
      "id": "shared-element",
      "label": "Shared Element",
      "recipe": "layout-deform",
      "timingRef": "easeInOut",
      "notes": ["Asset Card → Detail · 非普通 page transition"]
    },
    {
      "id": "list-insert",
      "label": "List Insert",
      "recipe": "enter",
      "springRef": "default"
    },
    {
      "id": "list-delete",
      "label": "List Delete",
      "recipe": "interactive"
    },
    {
      "id": "transaction",
      "label": "Crypto Transaction",
      "states": ["pending", "confirming", "confirmed"],
      "recipe": "layout-deform",
      "success": { "recipe": "success" }
    },
    {
      "id": "swap",
      "label": "Crypto Swap",
      "recipe": "enter",
      "timingRef": "easeInOut",
      "notes": ["Token A ↔ Token B · Quote morph"]
    },
    {
      "id": "security-signing",
      "label": "Security Signing",
      "presentation": { "recipe": "sheet" },
      "success": { "recipe": "success" },
      "error": { "recipe": "error" }
    },
    {
      "id": "wallet-connect",
      "label": "Wallet Connect",
      "states": ["idle", "connecting", "connected"],
      "recipe": "enter",
      "haptic": { "connected": "success" }
    }
  ]
}
