{
  "name": "@eds-evergreen/mobile",
  "version": "0.1.0",
  "description": "EverGreen Design System (Mobile) — tokens, animations, components",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "android", "expo-module.config.json", "README.md"],
  "scripts": {
    "build": "node scripts/assemble.mjs",
    "typecheck": "echo \"Assembled from workspace packages\""
  },
  "publishConfig": { "access": "public" },
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-svg": ">=15",
    "react-native-reanimated": ">=3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./animations": {
      "types": "./dist/animations/index.d.ts",
      "import": "./dist/animations/index.js",
      "require": "./dist/animations/index.js",
      "default": "./dist/animations/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/js/theme.d.ts",
      "import": "./dist/tokens/js/theme.js",
      "require": "./dist/tokens/js/theme.js",
      "default": "./dist/tokens/js/theme.js"
    },
    "./tokens/css": "./dist/tokens/css/index.css",
    "./tokens/json": "./dist/tokens/json/tokens.json",
    "./tokens/corner-smoothing": {
      "import": "./dist/tokens/js/corner-smoothing.js",
      "require": "./dist/tokens/js/corner-smoothing.js",
      "default": "./dist/tokens/js/corner-smoothing.js"
    },
    "./tokens/fonts-native": {
      "types": "./dist/tokens/js/fonts-native.d.ts",
      "import": "./dist/tokens/js/fonts-native.js",
      "require": "./dist/tokens/js/fonts-native.js",
      "default": "./dist/tokens/js/fonts-native.js"
    },
    "./tokens/liquid-glass": {
      "import": "./dist/tokens/js/liquid-glass.js",
      "require": "./dist/tokens/js/liquid-glass.js",
      "default": "./dist/tokens/js/liquid-glass.js"
    },
    "./tokens/motion/catalog": "./dist/tokens/json/motion/catalog.json"
  }
}
