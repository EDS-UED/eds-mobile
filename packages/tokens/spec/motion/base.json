        { "name": "motion-glass-scale-press-xs", "value": "1.02", "comment": "Glass press · xs" },
        { "name": "motion-glass-scale-press-sm", "value": "1.04", "comment": "Glass press · sm" },
        { "name": "motion-glass-scale-press-md", "value": "1.2", "comment": "Glass press · md" },
