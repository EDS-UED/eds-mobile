{
  "$figma": "https://www.figma.com/design/LlB2jT8KdxM6taf5wOSAEM/EverGreen-Design-System--Mobile-",
  "$description": "EDS Mobile Motion Recipe — 组合 Base 参数为可复用配方；Semantic 只引用 recipe id + css var。",
  "namedRecipes": [
    { "id": "press", "label": "Press", "springRef": "press", "hapticRef": "light", "cssRecipe": "motion-recipe-tap", "semanticClass": "motion-tap" },
    { "id": "interactive", "label": "Interactive", "springRef": "interactive", "hapticRef": "selection", "velocityAware": true, "interruptible": true },
    { "id": "navigation", "label": "Navigation", "springRef": "navigation", "timingRef": "navigationPush", "cssRecipe": "motion-recipe-page-push", "semanticClass": "motion-page" },
    { "id": "sheet", "label": "Sheet", "springRef": "sheet", "hapticRef": "selection", "cssRecipe": "motion-recipe-flotation-enter", "semanticClass": "motion-flotation" },
    { "id": "modal", "label": "Modal", "springRef": "modal", "cssRecipe": "motion-recipe-flotation-enter", "semanticClass": "motion-flotation" },
    { "id": "control", "label": "Control", "springRef": "control", "cssRecipe": "motion-recipe-control", "semanticClass": "motion-deform", "hapticRef": "selection" },
    { "id": "enter", "label": "Enter", "timingRef": "easeIn", "cssRecipe": "motion-recipe-enter", "semanticClass": "motion-focus" },
    { "id": "exit", "label": "Exit", "timingRef": "easeOut", "cssRecipe": "motion-recipe-exit" },
    { "id": "expand", "label": "Expand", "springRef": "gentle", "cssRecipe": "motion-recipe-enter", "semanticClass": "motion-layout" },
    { "id": "collapse", "label": "Collapse", "springRef": "gentle", "timingRef": "easeOut", "cssRecipe": "motion-recipe-exit", "semanticClass": "motion-layout" },
    { "id": "layout-deform", "label": "Layout Deform", "springRef": "gentle", "cssRecipe": "motion-recipe-layout-deform-shell", "semanticClass": "motion-layout-deform" },
    { "id": "scroll-fade", "label": "Scroll Fade", "cssRecipe": "motion-recipe-scroll-fade" },
    { "id": "drag", "label": "Drag", "springRef": "drag", "hapticRef": "light", "velocityAware": true, "interruptible": true },
    { "id": "dismiss", "label": "Dismiss", "springRef": "interactive", "timingRef": "easeOut", "semanticClass": "motion-flotation", "velocityAware": true },
    { "id": "success", "label": "Success", "springRef": "bouncy", "hapticRef": "success" },
    { "id": "error", "label": "Error", "springRef": "press", "timingRef": "easeOut", "hapticRef": "error" },
    { "id": "loading", "label": "Loading", "timingRef": "easeInOut", "cssRecipe": "motion-recipe-fade" }
  ],
  "groups": [
    {
      "comment": "Duration roles（→ eds-motion-N）",
      "tokenList": [
        { "name": "motion-duration-instant", "value": "var(--eds-motion-0)" },
        { "name": "motion-duration-micro", "value": "var(--eds-motion-1)" },
        { "name": "motion-duration-fast", "value": "var(--eds-motion-2)" },
        { "name": "motion-duration-normal", "value": "var(--eds-motion-3)" },
        { "name": "motion-duration-slow", "value": "var(--eds-motion-4)" },
        { "name": "motion-duration-emphasis", "value": "var(--eds-motion-5)" },
        { "name": "motion-duration-control", "value": "var(--eds-motion-6)" },
        { "name": "motion-duration-navigation", "value": "var(--eds-motion-7)" },
        { "name": "motion-duration-spin", "value": "var(--eds-motion-8)" },
        { "name": "motion-duration-spin-slow", "value": "var(--eds-motion-9)" },
        { "name": "motion-duration-fade", "value": "var(--eds-motion-2)" },
        { "name": "motion-duration-enter", "value": "var(--eds-motion-3)" },
        { "name": "motion-duration-exit", "value": "var(--eds-motion-2)" },
        { "name": "motion-duration-tap", "value": "var(--eds-motion-1)" },
        { "name": "motion-duration-shift", "value": "var(--eds-motion-3)" },
        { "name": "motion-duration-scroll-fade", "value": "var(--eds-motion-5)" },
        { "name": "motion-duration-layout-deform", "value": "var(--eds-motion-7)" },
        { "name": "motion-duration-layout-deform-content", "value": "var(--eds-motion-2)" },
        { "name": "motion-delay-layout-deform-content-swap", "value": "120ms" },
        { "name": "motion-delay-feedback-tick", "value": "var(--eds-motion-3)" }
      ]
    },
    {
      "comment": "Easing roles",
      "tokenList": [
        { "name": "motion-easing-standard", "value": "var(--eds-motion-ease-1)" },
        { "name": "motion-easing-enter", "value": "var(--eds-motion-ease-2)" },
        { "name": "motion-easing-exit", "value": "var(--eds-motion-ease-3)" },
        { "name": "motion-easing-product", "value": "var(--eds-motion-ease-4)" },
        { "name": "motion-easing-linear", "value": "var(--eds-motion-ease-5)" },
        { "name": "motion-easing-spring", "value": "var(--eds-motion-ease-6)" },
        { "name": "motion-easing-spring-emphasis", "value": "var(--eds-motion-ease-7)" },
        { "name": "motion-easing-decelerate", "value": "var(--eds-motion-ease-8)" },
        { "name": "motion-easing-navigation", "value": "var(--eds-motion-ease-9)" }
      ]
    },
    {
      "comment": "Property bundles",
      "tokenList": [
        {
          "name": "motion-property-paint",
          "value": "background-color, color, border-color, box-shadow, opacity, outline-color, fill"
        },
        {
          "name": "motion-property-geometry",
          "value": "flex, max-width, width, min-width, max-height, transform, left, padding"
        },
        { "name": "motion-property-fade", "value": "opacity" },
        { "name": "motion-property-transform", "value": "transform, opacity" }
      ]
    },
    {
      "comment": "Recipes",
      "tokenList": [
        {
          "name": "motion-recipe-fade",
          "value": "opacity var(--motion-duration-fade) var(--motion-easing-standard)"
        },
        {
          "name": "motion-recipe-enter",
          "value": "opacity var(--motion-duration-enter) var(--motion-easing-enter), transform var(--motion-duration-enter) var(--motion-easing-enter)"
        },
        {
          "name": "motion-recipe-exit",
          "value": "opacity var(--motion-duration-exit) var(--motion-easing-exit), transform var(--motion-duration-exit) var(--motion-easing-exit)"
        },
        {
          "name": "motion-recipe-tap",
          "value": "background-color var(--motion-duration-tap) var(--motion-easing-standard), color var(--motion-duration-tap) var(--motion-easing-standard), border-color var(--motion-duration-tap) var(--motion-easing-standard), opacity var(--motion-duration-tap) var(--motion-easing-standard), transform var(--motion-duration-micro) var(--motion-easing-product), fill var(--motion-duration-tap) var(--motion-easing-standard)"
        },
        {
          "name": "motion-recipe-flotation-enter",
          "value": "opacity var(--motion-duration-enter) var(--motion-easing-standard), transform var(--motion-duration-emphasis) var(--motion-easing-spring-emphasis)"
        },
        {
          "name": "motion-recipe-flotation-exit",
          "value": "opacity var(--motion-duration-exit) var(--motion-easing-exit), transform var(--motion-duration-fast) var(--motion-easing-decelerate)"
        },
        {
          "name": "motion-recipe-control",
          "value": "transform var(--motion-duration-control) var(--motion-easing-product), width var(--motion-duration-control) var(--motion-easing-product)"
        },
        {
          "name": "motion-recipe-shift",
          "value": "flex var(--motion-duration-shift) var(--motion-easing-standard), max-width var(--motion-duration-shift) var(--motion-easing-standard), width var(--motion-duration-shift) var(--motion-easing-standard), min-width var(--motion-duration-shift) var(--motion-easing-standard), max-height var(--motion-duration-shift) var(--motion-easing-standard), transform var(--motion-duration-shift) var(--motion-easing-standard), left var(--motion-duration-shift) var(--motion-easing-standard), padding var(--motion-duration-shift) var(--motion-easing-standard)"
        },
        {
          "name": "motion-recipe-scroll-fade",
          "value": "opacity var(--motion-duration-scroll-fade) var(--motion-easing-decelerate)"
        },
        {
          "name": "motion-recipe-scroll-fade-background",
          "value": "background var(--motion-duration-scroll-fade) var(--motion-easing-decelerate)"
        },
        {
          "name": "motion-recipe-page-push",
          "value": "opacity var(--motion-duration-navigation) var(--motion-easing-navigation), transform var(--motion-duration-navigation) var(--motion-easing-navigation)"
        },
        {
          "name": "motion-recipe-layout-deform-shell",
          "value": "height var(--motion-duration-layout-deform) var(--motion-easing-decelerate), max-height var(--motion-duration-layout-deform) var(--motion-easing-decelerate), width var(--motion-duration-layout-deform) var(--motion-easing-decelerate), max-width var(--motion-duration-layout-deform) var(--motion-easing-decelerate)"
        },
        {
          "name": "motion-recipe-layout-deform-content",
          "value": "opacity var(--motion-duration-layout-deform-content) ease, transform var(--motion-duration-layout-deform) var(--motion-easing-decelerate)"
        }
      ]
    },
    {
      "comment": "Displace（方向位移 glue）",
      "tokenList": [
        { "name": "motion-displace-from-bottom", "value": "translateY(var(--motion-distance-sm))" },
        { "name": "motion-displace-from-top", "value": "translateY(calc(-1 * var(--motion-distance-sm)))" },
        { "name": "motion-displace-from-left", "value": "translateX(calc(-1 * var(--motion-distance-sm)))" },
        { "name": "motion-displace-from-right", "value": "translateX(var(--motion-distance-sm))" }
      ]
    }
  ],
  "reducedMotionOverrides": [
    { "name": "motion-duration-micro", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-fast", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-normal", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-slow", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-emphasis", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-control", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-navigation", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-fade", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-enter", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-exit", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-tap", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-shift", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-scroll-fade", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-spin", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-spin-slow", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-layout-deform", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-layout-deform-content", "value": "var(--eds-motion-0)" },
    { "name": "motion-delay-layout-deform-content-swap", "value": "var(--eds-motion-0)" },
    { "name": "motion-delay-feedback-tick", "value": "var(--eds-motion-0)" }
  ]
}
