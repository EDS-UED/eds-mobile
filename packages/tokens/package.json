{
  "name": "@eds/mobile-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens for EverGreen Design System (Mobile)",
  "type": "module",
  "main": "./dist/css/index.css",
  "exports": {
    ".": "./dist/css/index.css",
    "./scale": "./dist/css/scale/index.css",
    "./scale/base": "./dist/css/scale/base.css",
    "./scale/semantic": "./dist/css/scale/semantic.css",
    "./typography": "./dist/css/typography/index.css",
    "./typography/base": "./dist/css/typography/base.css",
    "./typography/semantic": "./dist/css/typography/semantic.css",
    "./text": "./dist/css/text/index.css",
    "./text/styles": "./dist/css/text/styles.css",
    "./fonts": "./dist/css/typography/fonts.css",
    "./motion": "./dist/css/motion/index.css",
    "./motion/base": "./dist/css/motion/base.css",
    "./motion/recipe": "./dist/css/motion/recipe.css",
    "./motion/semantic": "./dist/css/motion/semantic.css",
    "./motion/utilities": "./dist/css/motion/utilities.css",
    "./motion/catalog": "./dist/json/motion/catalog.json",
    "./effect": "./dist/css/effect/index.css",
    "./effect/light": "./dist/css/effect/themes/light.css",
    "./effect/dark": "./dist/css/effect/themes/dark.css",
    "./color": "./dist/css/color/index.css",
    "./color/light": "./dist/css/color/themes/light.css",
    "./color/dark": "./dist/css/color/themes/dark.css",
    "./tag": "./dist/css/color/tag/index.css",
    "./tag/light": "./dist/css/color/tag/themes/light.css",
    "./tag/dark": "./dist/css/color/tag/themes/dark.css",
    "./json": "./dist/json/tokens.json",
    "./css": "./dist/css/index.css",
    "./theme": {
      "import": "./dist/js/theme.js",
      "types": "./dist/js/theme.d.ts"
    }
  },
  "files": [
    "dist",
    "spec",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync:figma": "node scripts/sync-from-figma.mjs",
    "typecheck": "echo \"No TypeScript in tokens package\""
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
