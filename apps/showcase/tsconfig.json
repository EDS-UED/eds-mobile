{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@eds/desktop-components": ["src/stubs/eds-components.ts"],
      "@eds/desktop-animations": ["../../packages/mobile-animations/src/index.ts"],
      "@eds/desktop-tokens": ["../../packages/tokens"],
      "@eds/desktop-tokens/*": ["../../packages/tokens/*"],
      "@eds/mobile-tokens": ["../../packages/tokens"],
      "@eds/mobile-tokens/*": ["../../packages/tokens/*"]
    },
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
