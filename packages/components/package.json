{
  "name": "@eds/mobile-components",
  "version": "0.1.0",
  "private": true,
  "description": "React Native components for EDS Mobile",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "react-native": "./src/catalogEntry.ts",
      "import": "./dist/catalogEntry.js",
      "types": "./dist/catalogEntry.d.ts",
      "default": "./dist/catalogEntry.js"
    },
    "./preview/liquid-glass": {
      "react-native": "./src/preview/LiquidGlassDemo.tsx",
      "import": "./dist/preview/LiquidGlassDemo.js",
      "types": "./dist/preview/LiquidGlassDemo.d.ts",
      "default": "./dist/preview/LiquidGlassDemo.js"
    },
    "./preview/motion": {
      "react-native": "./src/preview/MotionDemo.tsx",
      "import": "./dist/preview/MotionDemo.js",
      "types": "./dist/preview/MotionDemo.d.ts",
      "default": "./dist/preview/MotionDemo.js"
    },
    "./preview/atom-gallery": {
      "react-native": "./src/preview/AtomGallery.tsx",
      "import": "./dist/preview/AtomGallery.js",
      "types": "./dist/preview/AtomGallery.d.ts",
      "default": "./dist/preview/AtomGallery.js"
    },
    "./preview/parity": {
      "react-native": "./src/preview/ParityHarness.tsx",
      "import": "./dist/preview/ParityHarness.js",
      "types": "./dist/preview/ParityHarness.d.ts",
      "default": "./dist/preview/ParityHarness.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "generate": "node scripts/generate-catalog.mjs && pnpm generate:assets",
    "generate:assets": "node --experimental-strip-types scripts/generate-atom-assets.mjs",
    "prebuild": "node scripts/generate-catalog.mjs && pnpm generate:assets",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"No linter configured yet\""
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-svg": ">=15",
    "react-native-reanimated": ">=3",
    "react-native-gesture-handler": ">=2",
    "react-native-safe-area-context": ">=4",
    "expo-router": ">=6"
  },
  "peerDependenciesMeta": {
    "expo-router": {
      "optional": true
    }
  },
  "dependencies": {
    "@eds/mobile-animations": "workspace:*",
    "@eds/mobile-tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "typescript": "^5.7.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-worklets": "~0.10.1"
  }
}
