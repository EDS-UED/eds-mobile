{
  "$figma": "https://www.figma.com/design/LlB2jT8KdxM6taf5wOSAEM/EverGreen-Design-System--Mobile-",
  "$description": "EDS Mobile Motion Base — duration / easing / distance / scale / opacity。仅物理量，无场景语义。",
  "groups": [
    {
      "comment": "Duration ladder（--motion-N · ms）",
      "tokens": {
        "motion-0": "0ms",
        "motion-1": "85ms",
        "motion-2": "180ms",
        "motion-3": "280ms",
        "motion-4": "400ms",
        "motion-5": "500ms",
        "motion-6": "250ms",
        "motion-7": "350ms",
        "motion-8": "800ms",
        "motion-9": "2000ms"
      },
      "usageNotes": [
        "0 instant · 1 micro (press/selection) · 2 fast (fade/icon)",
        "3 normal (simple transition) · 4 slow (large content) · 5 emphasis",
        "6 control (tab/toggle) · 7 navigation timing · 8–9 spinner"
      ]
    },
    {
      "comment": "Easing（--motion-ease-N）",
      "tokens": {
        "motion-ease-1": "cubic-bezier(0.42, 0, 0.58, 1)",
        "motion-ease-2": "cubic-bezier(0.2, 0, 0, 1)",
        "motion-ease-3": "cubic-bezier(0.4, 0, 1, 1)",
        "motion-ease-4": "cubic-bezier(0.4, 0, 0.2, 1)",
        "motion-ease-5": "linear",
        "motion-ease-6": "cubic-bezier(0.34, 1.4, 0.64, 1)",
        "motion-ease-7": "cubic-bezier(0.34, 1.45, 0.64, 1)",
        "motion-ease-8": "cubic-bezier(0.22, 1, 0.36, 1)",
        "motion-ease-9": "cubic-bezier(0.32, 0.72, 0, 1)"
      },
      "usageNotes": [
        "ease-1 standard · ease-2 entrance · ease-3 exit · ease-4 product",
        "ease-5 linear (spinner) · ease-6/7 spring-emphasis · ease-8 decelerate",
        "ease-9 navigation push (iOS-like)"
      ]
    },
    {
      "comment": "Opacity",
      "tokenList": [
        { "name": "motion-opacity-hidden", "value": "0" },
        { "name": "motion-opacity-dim", "value": "0.4" },
        { "name": "motion-opacity-subtle", "value": "0.7" },
        { "name": "motion-opacity-visible", "value": "1" },
        { "name": "motion-opacity-disabled", "value": "0.5" }
