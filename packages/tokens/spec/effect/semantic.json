{
  "$description": "Effect System semantic classes — Glass Box 场景（Figma Glass Box 组件集）。CSS class 与 mobileTheme.glass.boxes 一一对应；RN 消费 resolveGlassBoxComposition（组合层 fill + overlayGradient + shadows + backdropBlur）。",
  "scenarioKeys": {
    "button": "glass-button-box",
    "flotation": "glass-flotation-box",
    "tabBar": "glass-tabbar-box",
    "tabBarBg": "glass-tabbar-bg",
    "mask": "glass-mask-box"
  },
  "groups": [
    {
      "comment": "玻璃容器（Glass Box）",
      "styles": [
        {
          "title": "玻璃按钮容器（Button Box）",
          "className": "glass-button-box",
          "properties": {
            "border-radius": "var(--radius-xl)",
            "border": "var(--stroke-xs) solid var(--stroke-base-quaternary)",
            "background": "linear-gradient(0deg, var(--effect-overlay-subtle) 0%, var(--effect-overlay-shallow) 100%), var(--effect-box)",
            "box-shadow": "var(--eds-shadow-box-subtle)",
            "backdrop-filter": "var(--eds-blur-glass)",
            "-webkit-backdrop-filter": "var(--eds-blur-glass)"
          }
        },
        {
          "title": "浮层容器（Flotation Box）",
          "className": "glass-flotation-box",
          "properties": {
            "border-radius": "var(--radius-xl)",
            "border": "var(--stroke-xs) solid var(--stroke-base-quaternary)",
            "background": "linear-gradient(0deg, var(--effect-overlay-subtle) 0%, var(--effect-overlay-shallow) 100%), var(--effect-box)",
            "box-shadow": "var(--eds-shadow-box-shallow)",
            "backdrop-filter": "var(--eds-blur-glass)",
            "-webkit-backdrop-filter": "var(--eds-blur-glass)"
          }
        },
        {
          "title": "TabBar 容器（TabBar Box）",
          "className": "glass-tabbar-box",
          "properties": {
            "border-radius": "var(--radius-xl)",
            "border": "var(--stroke-xs) solid var(--stroke-base-quaternary)",
            "background": "linear-gradient(0deg, var(--effect-overlay-subtle) 0%, var(--effect-overlay-shallow) 100%), var(--effect-box)",
            "box-shadow": "var(--eds-shadow-box-deep)",
            "backdrop-filter": "var(--eds-blur-glass)",
            "-webkit-backdrop-filter": "var(--eds-blur-glass)"
          }
        },
        {
          "title": "TabBar 底衬（Glass BG）",
          "className": "glass-tabbar-bg",
          "properties": {
            "background": "linear-gradient(0deg, var(--effect-overlay-subtle) 0%, var(--effect-overlay-deep) 70%)"
          }
        },
        {
          "title": "置顶容器（Mask Box）",
          "className": "glass-mask-box",
          "properties": {
            "background": "linear-gradient(0deg, var(--effect-overlay-subtle) 0%, var(--effect-overlay-shallow) 100%), var(--effect-box)",
            "backdrop-filter": "var(--eds-blur-glass)",
            "-webkit-backdrop-filter": "var(--eds-blur-glass)"
          }
        }
      ]
    }
  ]
}
