{
  "name": "@eds/mobile-components",
  "version": "0.1.0",
  "private": true,
  "description": "React Native components for EDS Mobile",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "generate": "node scripts/generate-catalog.mjs",
    "prebuild": "node scripts/generate-catalog.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"No linter configured yet\""
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-svg": ">=15",
    "react-native-reanimated": ">=3"
  },
  "dependencies": {
    "@eds/mobile-tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "typescript": "^5.7.3"
  }
}
