{
  "name": "@eds/mobile-animations",
  "version": "0.1.0",
  "private": true,
  "description": "iOS-native motion presets for EverGreen Design System (Mobile)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"No linter configured yet\""
  },
  "dependencies": {
    "@eds/mobile-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76",
    "react-native-reanimated": ">=3",
    "react-native-svg": ">=15"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "react": "19.1.0",
    "react-native": "0.88.0",
    "react-native-svg": "15.14.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-worklets": "~0.13.0",
    "typescript": "^5.7.3"
  }
}
