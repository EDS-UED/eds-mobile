{
  "name": "@eds/mobile-showcase",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "predev": "node ../../scripts/ensure-built.mjs @eds/mobile-tokens && node scripts/extract-dist-css-manifest.mjs",
    "dev": "expo start --port 8080",
    "start": "expo start --port 8080",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "verify:color-tokens": "node scripts/verify-color-token-catalog.mjs",
    "verify:tokens": "node scripts/verify-token-catalog.mjs"
  },
  "dependencies": {
    "@eds/mobile-animations": "workspace:*",
    "@eds/mobile-components": "workspace:*",
    "@eds/mobile-tokens": "workspace:*",
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/ui": "~58.0.0",
    "@react-native-segmented-control/segmented-control": "^2.5.7",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.19.0",
    "@react-navigation/stack": "^7",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.20",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "^58.0.4",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.27",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "~0.13.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/metro-config": "0.88.0",
    "@types/react": "~19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^6.0.3"
  }
}
